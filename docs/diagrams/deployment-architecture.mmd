graph TB
    subgraph "Container Image"
        MULTI_STAGE[Multi-stage Docker Build]
        BUILDER[Stage 1: golang:1.22-alpine<br/>• Build static binary<br/>• CGO_ENABLED=0<br/>• Cached dependencies]
        RUNTIME[Stage 2: distroless/static-debian12<br/>• No shell<br/>• No package manager<br/>• Minimal attack surface<br/>• nonroot user]
    end

    subgraph "Local Development"
        COMPOSE[Docker Compose]
        PG_LOCAL[PostgreSQL 16<br/>localhost:5432<br/>Health check]
        REDIS_LOCAL[Redis 7<br/>localhost:6379<br/>Health check]
        APP_LOCAL[Go App<br/>localhost:8080<br/>Auto-reload with make run]
    end

    subgraph "Production Deployment"
        K8S_READY[Kubernetes Ready]
        REPLICAS[Multiple API Replicas<br/>Horizontal scaling]
        HEALTH_PROBE[Liveness Probe<br/>GET /health]
        READY_PROBE[Readiness Probe<br/>GET /ready<br/>Checks PostgreSQL + Redis]
    end

    subgraph "External Dependencies"
        PG_PROD[(Managed PostgreSQL<br/>SSL/TLS required<br/>Connection pooling)]
        REDIS_PROD[(Managed Redis<br/>rediss:// TLS<br/>AOF persistence)]
    end

    subgraph "Configuration"
        ENV_VARS[Environment Variables<br/>• DATABASE_URL<br/>• REDIS_URL<br/>• JWT_SECRET from secrets<br/>• Rate limits<br/>• CORS origins]
        MIGRATIONS[Embedded Migrations<br/>Auto-run on startup<br/>internal/db/migrations/*.sql]
    end

    subgraph "Observability"
        LOGS[Structured JSON Logs<br/>zerolog<br/>• request_id<br/>• latency<br/>• status codes]
        GRACEFUL[Graceful Shutdown<br/>SIGTERM/SIGINT<br/>30s drain timeout]
    end

    MULTI_STAGE --> BUILDER
    BUILDER --> RUNTIME

    RUNTIME --> COMPOSE
    RUNTIME --> K8S_READY

    COMPOSE --> PG_LOCAL
    COMPOSE --> REDIS_LOCAL
    COMPOSE --> APP_LOCAL

    K8S_READY --> REPLICAS
    REPLICAS --> HEALTH_PROBE
    REPLICAS --> READY_PROBE

    REPLICAS --> PG_PROD
    REPLICAS --> REDIS_PROD

    ENV_VARS --> APP_LOCAL
    ENV_VARS --> REPLICAS

    MIGRATIONS --> APP_LOCAL
    MIGRATIONS --> REPLICAS

    LOGS --> APP_LOCAL
    LOGS --> REPLICAS

    GRACEFUL --> REPLICAS

